# faceaccess.service - Reconocimiento facial (Python: captura + reconocimiento + SQLite).
# instalar.sh reemplaza @USUARIO@ y @DIR@ y lo copia a /etc/systemd/system/.
[Unit]
Description=FaceAccessPi - reconocimiento facial YuNet + SFace
Wants=faceaccess-led.service
After=faceaccess-led.service graphical.target

[Service]
Type=simple
User=@USUARIO@
WorkingDirectory=@DIR@
# Espera la sesion grafica (monitor) hasta 30 s; si no hay, funciona sin ventana
ExecStart=@DIR@/scripts/iniciar_vision.sh
Restart=always
RestartSec=2
# SIGTERM -> el programa apaga el LED y escribe el resumen de metricas
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=graphical.target

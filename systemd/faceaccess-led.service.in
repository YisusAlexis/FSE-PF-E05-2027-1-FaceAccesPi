# faceaccess-led.service - Programa en C del NeoPixel (lee la FIFO, escribe por SPI0).
# instalar.sh reemplaza @USUARIO@ y @DIR@ y lo copia a /etc/systemd/system/.
[Unit]
Description=FaceAccessPi - senalizacion NeoPixel por SPI
After=local-fs.target
# Arranca antes que el reconocimiento para que la FIFO ya exista
Before=faceaccess.service

[Service]
Type=simple
User=@USUARIO@
WorkingDirectory=@DIR@
ExecStart=@DIR@/led/neopixel_spi
# Decision bitacora clase 8: la senalizacion tiene mayor prioridad que la vision (nice -5)
Nice=-5
# Falla inducida 2: si el proceso muere, systemd lo reinicia en 1 s
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
